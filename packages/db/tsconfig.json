{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    // Betikler Node'un tip silme özelliğiyle doğrudan çalıştırılır (node scripts/x.ts);
    // bu yüzden yalnızca silinebilen TypeScript sözdizimine izin verilir.
    "erasableSyntaxOnly": true,
    "noEmit": true
  },
  "include": ["schema", "scripts", "drizzle.config.ts"]
}
