{
  "name": "@ambarci/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./demo": {
      "types": "./dist/seed/demo-data.d.ts",
      "default": "./dist/seed/demo-data.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "node scripts/check-connection.ts",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "seed": "node scripts/seed.ts",
    "test:db": "vitest run",
    "lint": "eslint src schema scripts seed test drizzle.config.ts vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "postgres": "^3.4.9"
  }
}
