            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "STOCK_IN",
              "STOCK_OUT",
              "TRANSFER",
              "COUNT",
              "WASTE",
              "OPENING",
              "REVERSAL"
            ]
