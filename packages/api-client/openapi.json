    "/v1/operations/{operationId}/confirm": {
      "post": {
        "operationId": "OperationsController_confirm",
        "parameters": [
          {
            "name": "operationId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
