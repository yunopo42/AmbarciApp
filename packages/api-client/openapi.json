  "info": {
    "title": "Ambarcı API",
    "description": "Ambarcı saha stok asistanı REST API",
    "version": "v1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "organization": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Organization-Id",
        "description": "Aktif şirketin kimliği; API kullanıcının o şirketteki üyeliğini doğrular"
      }
    },
    "schemas": {
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Supabase Auth kullanıcı kimliği"
          },
          "email": {
            "type": "string",
            "nullable": true,
            "example": "saha@ornek.com"
          }
        },
        "required": [
          "id",
          "email"
        ]
      },
      "ApiErrorDetailDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "AUTH_REQUIRED"
          },
          "message": {
            "type": "string",
            "example": "Oturum açmanız gerekiyor."
          },
          "details": {
            "type": "object"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDetailDto"
          }
        },
        "required": [
          "error"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "CreateOrganizationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "example": "ABC Elektrik"
          }
        },
        "required": [
          "name"
        ]
      },
      "OrganizationMembershipDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
