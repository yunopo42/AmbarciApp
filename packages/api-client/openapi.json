              }
            }
          }
        },
        "responses": {
          "200": {
            "headers": {
              "Server-Timing": {
                "description": "Onay transaction'ının sunucudaki süresi, ör. db;dur=182.4 (ms)",
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfirmOperationResultDto"
                }
              }
            }
          },
          "400": {
            "description": "Şirket seçilmemiş ya da kimlik geçersiz",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorDto"
