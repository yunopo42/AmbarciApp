{
  "name": "ambarci",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter @ambarci/shared --filter @ambarci/db build",
    "lint": "pnpm build:packages && pnpm -r lint",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r test",
    "db:check": "pnpm --filter @ambarci/db check",
    "db:generate": "pnpm --filter @ambarci/db generate",
    "db:migrate": "pnpm --filter @ambarci/db migrate",
    "db:seed": "pnpm build:packages && pnpm --filter @ambarci/db seed && pnpm --filter @ambarci/api seed:opening",
    "db:test": "pnpm -r --workspace-concurrency=1 test:db",
    "measure:latency": "pnpm build:packages && pnpm --filter @ambarci/api measure:latency",
    "measure:remote": "pnpm build:packages && pnpm --filter @ambarci/api measure:remote"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "catalog:",
    "globals": "^17.13.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.1"
  }
}
