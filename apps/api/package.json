{
  "name": "@ambarci/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint src test test-db",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "seed:opening": "nest build && node dist/scripts/seed-opening-stock.js",
    "measure:latency": "vitest run --config vitest.measure.config.ts",
    "measure:remote": "nest build && node dist/scripts/measure-confirm-remote.js",
    "gen:openapi": "nest build && node dist/scripts/generate-openapi.js"
  },
  "dependencies": {
    "@ambarci/db": "workspace:*",
    "@ambarci/shared": "workspace:*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.2",
    "drizzle-orm": "catalog:",
    "jose": "^6.2.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "eslint": "catalog:",
    "supertest": "^7.3.1",
    "typescript": "catalog:",
    "vitest": "^5.0.3"
  }
}
