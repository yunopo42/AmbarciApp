# Ambarcı ortam değişkenleri örneği.
# Bu dosyayı .env adıyla kopyalayıp değerleri doldurun; .env asla commit edilmez.
# Service role, veritabanı ve Claude anahtarları yalnızca backend'de (apps/api) kullanılır;
# mobil veya web paketine girmez.

# --- Supabase ---
# API, oturum token'larını bu projenin JWKS adresindeki anahtarlarla doğrular; tanımlı değilse API açılmaz.
SUPABASE_URL=https://<proje-ref>.supabase.co
# İstemcilerin de kullanabileceği genel anahtar; veriyi RLS politikaları korur.
SUPABASE_ANON_KEY=
# RLS'yi atlar. Yalnızca sunucuda tutulur.
SUPABASE_SERVICE_ROLE_KEY=

# --- PostgreSQL ---
# Supabase panelindeki "Connect" ekranından alınır. Render gibi yalnızca IPv4 kullanan
# ortamlarda doğrudan bağlantı yerine "Session pooler" adresini kullanın.
DATABASE_URL=postgresql://<kullanici>:<sifre>@<host>:5432/postgres

# --- Claude ---
ANTHROPIC_API_KEY=
# Sohbet ve araç kullanımı (Haiku 4.5)
CLAUDE_CHAT_MODEL=claude-haiku-4-5
# İrsaliye ve belge okuma (Sonnet 5.5)
CLAUDE_DOC_MODEL=claude-sonnet-5-5

# --- Yayın adresleri ---
# Web panelinin çağırdığı API adresi. NEXT_PUBLIC_ önekli değişkenler tarayıcıya gömülür;
# buraya gizli bir değer yazmayın. Vercel'de Render'daki API adresi girilir.
NEXT_PUBLIC_API_URL=http://localhost:3001
# API'nin CORS ile izin verdiği tek adres: web paneli. Render'da Vercel'deki web adresi girilir.
WEB_ORIGIN=http://localhost:3000
